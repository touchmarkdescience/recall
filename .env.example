# Server-side transcription. Set STT_PROVIDER=gemini to use the existing Gemini path.
STT_PROVIDER=groq
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
# Optional comma-separated spellings of real names (Groq prompt, at most 224 tokens).
STT_VOCAB_HINT=
# Optional: Gemini audio transcription
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
# Optional: real AI extraction and contextual answers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: real background Web Push (generate with npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Required for a deployed reminder dispatcher; use a long random value
CRON_SECRET=
# Production database (server-only; leave unset for local SQLite)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Website signup and shared server protection (requires reviewed Supabase migration).
# Keep disabled until keys and the counter migration are ready.
ABUSE_PROTECTION_ENABLED=false
# During Play review: enable signup CAPTCHA independently, keeping usage limits off.
RECAPTCHA_SIGNUP_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=recall.touchmarkdes.com
RECAPTCHA_MIN_SCORE=0.5
# Native signup (Google reCAPTCHA Enterprise; separate Android/iOS keys).
# The API credential stays on the server. Mobile site keys are public config.
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_ANDROID_SITE_KEY=
RECAPTCHA_ANDROID_PACKAGE_NAME=com.touchmarkdes.recall
RECAPTCHA_IOS_SITE_KEY=
RECAPTCHA_IOS_BUNDLE_ID=com.touchmarkdes.recall
# Optional independent HMAC key; otherwise a server-only Supabase/reCAPTCHA secret is used.
ABUSE_HASH_SECRET=
# Optional quota overrides: see docs/WEBSITE_SECURITY.md.
