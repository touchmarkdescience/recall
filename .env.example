# Server-side transcription. Set STT_PROVIDER=gemini to use the existing Gemini path.
STT_PROVIDER=groq
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
# Optional comma-separated spellings of real names (Groq prompt, at most 224 tokens).
STT_VOCAB_HINT=
# Optional: Gemini audio transcription
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
# Optional: real AI extraction and contextual answers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: real background Web Push (generate with npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Required for a deployed reminder dispatcher; use a long random value
CRON_SECRET=
# Production database (server-only; leave unset for local SQLite)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
