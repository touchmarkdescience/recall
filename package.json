{
  "name": "voice-follow-up-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:dispatch": "node --env-file=.env.local scripts/dev-dispatch.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:extract": "node --experimental-strip-types scripts/test-extract.mjs",
    "test:security": "node --experimental-strip-types scripts/test-security.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@supabase/supabase-js": "^2.118.0",
    "chrono-node": "^2.9.0",
    "lucide-react": "^0.552.0",
    "luxon": "^3.7.2",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3"
  }
